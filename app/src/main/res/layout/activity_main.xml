<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Menú de Ejercicios"
        android:textSize="24sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnFirstExercise"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Primer Ejercicio (Input/Output)" />

    <Button
        android:id="@+id/btnCalculadora"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="2. Calculadora" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="3. Login (Con Intent a Error)" />

    <Button
        android:id="@+id/btnSensors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="4. Lectura de Sensores" />

</LinearLayout>